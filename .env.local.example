## Required: Turnkey parent organization ID
NEXT_PUBLIC_ORGANIZATION_ID=""

## Auth Proxy — from Turnkey dashboard
NEXT_PUBLIC_AUTH_PROXY_BASE_URL="https://authproxy.turnkey.com"
NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID=""

## Optional: WalletConnect project ID (get one at https://cloud.walletconnect.com)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

## Optional: custom Sepolia RPC (falls back to public node)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=""

